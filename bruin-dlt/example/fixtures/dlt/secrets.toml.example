# Placeholder shape of the fixture's dlt secrets file. It contains no real
# values. The bootstrap step renders .artifacts/dlt-project/.dlt/secrets.toml
# from this shape using the fixture's throwaway container credentials and the
# dynamically published container ports.
#
# A migration agent must never read the rendered secrets.toml. The connection
# converter in ../../.agents/skills/bruin-dlt-migrator/ reads it instead and
# writes Bruin connections without printing any value.

[sources.sql_database.credentials]
drivername = "postgresql"
database = "<postgres-database>"
username = "<postgres-username>"
password = "<postgres-password>"
host = "<postgres-host>"
port = 5432

[destination.clickhouse.credentials]
database = "<clickhouse-database>"
username = "<clickhouse-username>"
password = "<clickhouse-password>"
host = "<clickhouse-host>"
port = 9000
http_port = 8123
secure = 0
